% Оформление документов по ЕСПД (ГОСТ 19.106-78, ГОСТ 19.105-78) — упрощённый стиль для XeLaTeX
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{espd}
\RequirePackage{fontspec}
\RequirePackage{polyglossia}
\setdefaultlanguage{russian}
\setotherlanguage{english}
\setmainfont{Liberation Serif}
\setsansfont{Liberation Sans}
\setmonofont{Liberation Mono}
\newfontfamily\cyrillicfont{Liberation Serif}
\newfontfamily\cyrillicfontsf{Liberation Sans}
\newfontfamily\cyrillicfonttt{Liberation Mono}
\RequirePackage[a4paper,left=30mm,right=15mm,top=20mm,bottom=20mm,footskip=10mm]{geometry}
\RequirePackage{setspace}\onehalfspacing
\RequirePackage{indentfirst}\setlength{\parindent}{1.25cm}
\RequirePackage{titlesec}
\RequirePackage{graphicx}
\RequirePackage{longtable,booktabs,array}
\RequirePackage{enumitem}\setlist{nosep,leftmargin=1.75cm}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{caption}
\captionsetup{labelsep=endash,justification=centering}
\captionsetup[table]{justification=raggedright,singlelinecheck=false}
\RequirePackage{tocloft}
\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}
% Шифр документа выводится вверху каждой страницы (ГОСТ 19.106-78, п. 1.5)
\newcommand{\docode}[1]{\def\@docode{#1}}
\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[C]{\thepage\\\@docode}
\fancypagestyle{plain}{\fancyhf{}\fancyhead[C]{\thepage\\\@docode}}
% Заголовки: разделы — прописными, по центру; подразделы — с абзаца
\titleformat{\section}{\normalfont\bfseries\centering}{\thesection.}{0.5em}{\MakeUppercase}
\titleformat{\subsection}{\normalfont\bfseries}{\hspace{\parindent}\thesubsection.}{0.5em}{}
\titleformat{\subsubsection}{\normalfont}{\hspace{\parindent}\thesubsubsection.}{0.5em}{}
\titlespacing*{\section}{0pt}{12pt}{12pt}
\titlespacing*{\subsection}{0pt}{8pt}{6pt}
\AtBeginDocument{\renewcommand{\contentsname}{СОДЕРЖАНИЕ}}\renewcommand{\cfttoctitlefont}{\hfill\normalfont\bfseries}\renewcommand{\cftaftertoctitle}{\hfill}
